# Copy to .env and replace the values. Never commit .env.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=gatekeeper_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gatekeeper
POSTGRES_PORT=5434

# Used by the FastAPI app
DATABASE_URL=postgresql://gatekeeper_owner:change-me@localhost:5434/gatekeeper

# Anthropic API (chat model)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CHAT_MODEL=claude-opus-5-5

# Okta OIDC (Acme). Issuer is your authorization server, e.g. https://dev-123.okta.com/oauth2/default
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:8000/auth/okta/callback

# Signs the short-lived login session cookie. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Signs Gatekeeper access tokens (RS256). Generate with: cd backend && python -m scripts.gen_signing_key
TOKEN_SIGNING_KEY_B64=change-me
TOKEN_ISSUER=http://localhost:8000
